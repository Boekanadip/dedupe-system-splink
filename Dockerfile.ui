FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Expose port
EXPOSE 8501

# Run Streamlit UI
CMD ["streamlit", "run", "ui/app.py", "--server.host", "0.0.0.0", "--server.port", "8501"]
